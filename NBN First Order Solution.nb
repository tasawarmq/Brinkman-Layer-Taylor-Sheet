Cell[BoxData[
 RowBox[{"ux1", "==", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "U2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"\[Epsilon]", " ", "\[Eta]"}], "2"], "+", 
          FractionBox["1", 
           RowBox[{"2", "\[Epsilon]", " ", "\[Eta]"}]]}], ")"}]}], "+", 
       FractionBox[
        RowBox[{"U2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"H1", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              SuperscriptBox["\[Alpha]", "2"]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[Beta]", "2"], "-", "\[Mu]"}], ")"}], " ", 
            "\[Mu]"}], "+", 
           RowBox[{"2", " ", "\[Beta]", " ", 
            SqrtBox[
             RowBox[{
              RowBox[{"(", 
